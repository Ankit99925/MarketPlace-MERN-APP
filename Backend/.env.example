# Server
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://marketplace.appurihako.jp.net

# Database — Atlas connection string
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth — console.cloud.google.com
# Redirect URI must be registered for the production domain
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary — image hosting
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SendGrid — transactional email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Stripe — USE TEST KEYS for the demo deployment
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
